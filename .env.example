# Docker 部署配置（复制为 .env）
# 本 fork（ZeroVector）默认本地构建镜像 zerovector:local（见 docker-build.sh），
# 宿主端口 9787 / 9788，可与原版 ARTEX（8787 / 8788）同机并存。详见 FORK.md。
# 如需改用远端镜像，取消下面两行注释并填写地址：
# ARTEX_IMAGE=kismetpro/zerovector
# ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
