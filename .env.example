# Docker 部署配置（复制为 .env）
# 本 fork（ZeroVector）默认本地构建镜像 zerovector:local（见 docker-build.sh），
# 宿主端口 9787 / 9788，可与原版 ARTEX（8787 / 8788）同机并存。详见 FORK.md。
# 如需改用远端镜像，取消下面两行注释并填写地址：
# ARTEX_IMAGE=kismetpro/zerovector
# ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex
# PostgreSQL 调参（可不填，走 docker-compose.yml 里的默认值；按机器内存调整）
# 机器内存 8GB 左右 → shared_buffers 1GB / effective_cache_size 3GB
# 机器内存 16GB 左右 → 2GB / 6GB（默认）
# 机器内存 32GB 以上 → 4GB / 12GB；随机 IO 走 SSD 时 random_page_cost=1.1
# POSTGRES_SHARED_BUFFERS=2GB
# POSTGRES_EFFECTIVE_CACHE_SIZE=6GB
# POSTGRES_WORK_MEM=16MB
# POSTGRES_MAINTENANCE_WORK_MEM=512MB
# POSTGRES_MAX_WAL_SIZE=4GB
# POSTGRES_RANDOM_PAGE_COST=1.1

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
